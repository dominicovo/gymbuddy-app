{
  "expo": {
    "name": "gymbuddy",
    "slug": "gymbuddy",
    "version": "1.0.0",
    "scheme": "gymbuddy",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.dominiceburuoh.gymbuddy",
      "buildNumber": "11",
      "appleTeamId": "GA5P2J5N3R",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "GymBuddy",
        "NSCameraUsageDescription": "GymBuddy uses your camera to take a check-in photo at the gym before unlocking your apps.",
        "NSLocationWhenInUseUsageDescription": "GymBuddy uses your location to find gyms near you.",
        "CFBundleName": "GymBuddy",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.dominiceburuoh.gymbuddy"
        ]
      },
      "associatedDomains": [
        "applinks:www.gymbuddy.live"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "GymBuddy uses your camera to take a check-in photo at the gym before unlocking your apps.",
          "photosPermission": "GymBuddy uses your photos so you can pick a profile picture your buddies will see."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GymBuddy uses your location to find gyms near you."
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "GA5P2J5N3R",
          "appGroup": "group.com.dominiceburuoh.gymbuddy",
          "copyToTargetFolder": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1080082594649-thmnuttdo8cjq8igp331vbmio7l534il"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#08070C",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#08070C"
          }
        }
      ],
      "./plugins/withUISceneLifecycle.js",
      "expo-font"
    ]
  }
}
